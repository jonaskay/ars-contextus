---
import { Image } from "astro:assets";
import { type CollectionEntry, getCollection, render } from "astro:content";

import FormattedDate from "../../components/formatted-date.astro";
import BaseLayout from "../../layouts/base-layout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await render(post);

const relatedPosts = (await getCollection("blog"))
  .filter((item) => item.data.type === post.data.type)
  .sort(
    (a, b) =>
      a.data.publishedDate.valueOf() - b.data.publishedDate.valueOf() ||
      a.id.localeCompare(b.id),
  );
const postIndex = relatedPosts.findIndex((item) => item.id === post.id);
const previousPost = relatedPosts[postIndex - 1];
const nextPost = relatedPosts[postIndex + 1];
const itemType = post.data.type === "pattern" ? "pattern" : "post";
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <header class="relative">
    {
      post.data.image && (
        <div class="absolute inset-0 overflow-hidden">
          <div class="relative z-10 w-full max-w-4xl h-full mx-auto">
            <Image
              src={post.data.image}
              alt=""
              width={896}
              class={`w-full max-w-4xl h-full mx-auto object-cover ${post.data.imagePosition ?? "object-[50% 50%]"}`}
            />
            <div class="absolute inset-0 bg-black opacity-75" />
          </div>
        </div>
      )
    }
    <div
      class="relative container mx-auto px-4 sm:px-8 pt-12 sm:pt-36 pb-6 sm:pb-8 lg:pb-12"
    >
      <div class="relative z-20 lg:col-span-3 prose md:prose-lg mx-auto">
        <div class="text-neutral-300">
          <FormattedDate date={post.data.publishedDate} />
        </div>
        <h1 class="text-neutral-50">
          {post.data.title}
        </h1>
      </div>
    </div>
  </header>
  <main class="border-b border-neutral-200 dark:border-neutral-700">
    <div class="container mx-auto px-4 sm:px-8 py-8">
      <article
        class="prose md:prose-lg dark:prose-invert mx-auto mb-16 md:mb-24 text-wrap wrap-break-word"
      >
        <Content />
      </article>
      <div
        class="prose prose-headings:mt-0 md:prose-lg dark:prose-invert mx-auto mb-16"
      >
        <nav aria-label={`${itemType} navigation`}>
          {
            nextPost && (
                <hr class="border-t border-neutral-200 dark:border-neutral-400" />
                <a
                  href={`/blog/${nextPost.id}/`}
                  rel="next"
                  class="block no-underline hover:underline"
                >
                  <span class="text-neutral-200 uppercase tracking-wider">
                    Next {itemType}
                  </span>
                  <h3 class="mt-0">{nextPost.data.title}</h3>
                  <p>{nextPost.data.description}</p>
                </a>
            )
          }
          {
            previousPost && (
              <hr class="border-t border-neutral-200 dark:border-neutral-400" />
              <a
                href={`/blog/${previousPost.id}/`}
                rel="prev"
                class="block no-underline hover:underline"
              >
                <div class="text-neutral-200 uppercase tracking-wider">
                  Previous {itemType}
                </div>
                <h3 class="mt-0">{previousPost.data.title}</h3>
                <p>{previousPost.data.description}</p>
              </a>
            )
          }
        </nav>
      </div>
    </div>
  </main>
</BaseLayout>
